# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง
# API key ของ Anthropic (ถ้าไม่ใส่ เกมจะใช้โหมด mock: ข้อมูลตัวอย่างในเครื่อง)
ANTHROPIC_API_KEY=
# โมเดลที่ใช้เจนเนื้อหา (ค่าเริ่มต้น claude-opus-5-5; ถูกกว่า: claude-sonnet-5-5)
CLAUDE_MODEL=claude-opus-5-5
# บังคับใช้โหมด mock แม้มี key: AI_MODE=mock
AI_MODE=
# ปิด server-side refusal fallback: AI_FALLBACKS=off
AI_FALLBACKS=
# พอร์ตของเว็บ
PORT=3000

# ---------- กติกา ----------
# ผู้เล่นขั้นต่ำ
MIN_PLAYERS=3
# เวลาต่อจังหวะ "เลือกห้อง" / "เลือกแอ็กชัน" (มิลลิวินาที) หมดเวลาแล้วระบบเลือกให้เอง (0 = ไม่จำกัด หัวห้องกดบังคับได้เสมอ)
STEP_TIMEOUT_MS=240000
# จำนวนวันสูงสุด ครบแล้วเกมจบ ผู้ที่ยังอยู่ถือว่ารอด
MAX_DAYS=10
# ต้องมีคนพบศพกี่คน (ไม่นับคนฆ่า) ถึงจะประกาศและเข้าสู่รอบเก็บหลักฐาน (ลดเองตามจำนวนคนที่เหลือ)
BODY_DISCOVERERS=3
# ถือของได้สูงสุดกี่ชิ้น
INVENTORY_MAX=3
# จำนวนของสำหรับหนี (0 = อัตโนมัติ: ≤5 คนได้ 2 ชิ้น ไม่งั้น 3 ชิ้น)
ESCAPE_PARTS=0
# ภารกิจลับประจำวัน (ทำไม่ทัน = ตาย) ตั้ง false เพื่อปิด
OBJECTIVES=true
# โหวตเสมอ: โหวตรอบตัดสินเฉพาะตัวเลือกที่เสมอได้สูงสุดกี่รอบ ก่อนสุ่มตัดสิน
MAX_RUNOFFS=2
# โอกาส (0-1) ที่จะเกิดอีเวนต์พิเศษ "คืนชีพ" ตอนเริ่มวันใหม่หลังการตัดสิน
REVIVE_CHANCE=0.15
# Ultimate ที่ซ่อนเป็น ??? จริง ๆ = clamp(round(ผู้เล่น × RATIO), 1, MAX) → 10 คนได้ 2, 7 คนได้ 1
HIDDEN_ULTIMATE_RATIO=0.15
HIDDEN_ULTIMATE_MAX=2
# จำนวน "โรลปลอม" (Ultimate ที่ประกาศให้คนอื่นเห็นไม่ใช่ของจริง เจ้าของรู้ คนอื่นไม่รู้) ตั้ง 0 เพื่อปิด
FAKE_ROLES=1
