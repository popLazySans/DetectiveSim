# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง
# API key ของ Anthropic (ถ้าไม่ใส่ เกมจะใช้โหมด mock: ข้อมูลตัวอย่างในเครื่อง)
ANTHROPIC_API_KEY=
# โมเดลที่ใช้เจนเนื้อหา (ค่าเริ่มต้น claude-opus-5-5; ถูกกว่า: claude-sonnet-5-5)
CLAUDE_MODEL=claude-opus-5-5
# บังคับใช้โหมด mock แม้มี key: AI_MODE=mock
AI_MODE=
# ปิด server-side refusal fallback: AI_FALLBACKS=off
AI_FALLBACKS=
# พอร์ตของเว็บ
PORT=3000
# ผู้เล่นขั้นต่ำ และเวลาที่ฆาตกรมีสำหรับเลือกเป้าหมาย (มิลลิวินาที)
MIN_PLAYERS=3
NIGHT_TIMEOUT_MS=120000
# โหวตเสมอ: โหวตรอบตัดสินเฉพาะคนที่เสมอได้สูงสุดกี่รอบ ก่อนสุ่มตัดสิน
MAX_RUNOFFS=2
# ถ้า true คนที่ถูกโหวตผิดจะถูกประหารด้วย (ค่าเริ่มต้น false: คนร้ายหนีรอด ไม่มีใครตายเพิ่ม)
EXECUTE_WRONG_VOTE=false
# โอกาส (0-1) ที่จะเกิดอีเวนต์พิเศษ "คืนชีพ" ตอนเริ่มวันใหม่
REVIVE_CHANCE=0.2
# Ultimate ที่ซ่อนเป็น ??? จริง ๆ = clamp(round(ผู้เล่น × RATIO), 1, MAX) → 10 คนได้ 2, 7 คนได้ 1
HIDDEN_ULTIMATE_RATIO=0.15
HIDDEN_ULTIMATE_MAX=2
# จำนวน "โรลปลอม" (Ultimate ที่ประกาศให้คนอื่นเห็นไม่ใช่ของจริง เจ้าของรู้ คนอื่นไม่รู้) ตั้ง 0 เพื่อปิด
FAKE_ROLES=1
